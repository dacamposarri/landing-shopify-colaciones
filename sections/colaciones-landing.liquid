<style>
  .clx { --bg:#f7f3ec; --warm:#efe6d8; --surf:#fffcf7; --ink:#1c1917; --muted:#57534e; --subtle:#78716c; --line:#e7e0d4; --pri:#17663a; --pri-fg:#f7f3ec; --pri-soft:#e8f4ec; --urg:#9f1239; --urg-soft:#ffe4e6; --inv:#f7f3ec; --navy:#1c2430; font-family:Figtree,system-ui,sans-serif; color:var(--ink); background:var(--bg); line-height:1.55; padding-bottom:96px; -webkit-font-smoothing:antialiased; }
  .clx * { box-sizing:border-box; }
  .clx h1,.clx h2,.clx h3 { font-family:Fraunces,Georgia,serif; letter-spacing:-.03em; line-height:1.15; text-wrap:balance; margin:0; }
  .clx p { margin:0; text-wrap:pretty; }
  .clx a { color:inherit; }
  .clx img { max-width:100%; display:block; }
  .clx .wrap { width:min(1120px, calc(100% - 32px)); margin:0 auto; }
  .clx .kicker { text-align:center; font-size:12px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:var(--pri); }
  .clx .cta { display:inline-flex; align-items:center; justify-content:center; gap:8px; background:var(--pri); color:var(--pri-fg); text-decoration:none; font-weight:600; height:48px; padding:0 24px; border-radius:12px; width:100%; }
  .clx .cta:hover { filter:brightness(1.08); }
  .clx .bar { background:var(--navy); color:var(--inv); text-align:center; font-size:14px; font-weight:500; padding:10px 16px; display:flex; justify-content:center; align-items:center; gap:8px; flex-wrap:wrap; }
  .clx .pill { background:var(--surf); color:var(--ink); border-radius:999px; padding:2px 10px; font-variant-numeric:tabular-nums; font-weight:600; }
  .clx .hero { padding:48px 0 64px; }
  .clx .hero h1 { text-align:center; font-size:clamp(28px,4.4vw,54px); color:var(--pri); max-width:820px; margin:0 auto 16px; }
  .clx .lead { text-align:center; color:var(--muted); max-width:640px; margin:0 auto; font-size:18px; }
  .clx .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:32px; align-items:center; margin-top:48px; }
  .clx .clx-card { background:var(--surf); border:1px solid var(--line); border-radius:24px; padding:28px; }
  .clx .old { text-decoration:line-through; color:var(--subtle); }
  .clx .now { font-family:Fraunces,serif; color:var(--pri); font-size:48px; font-variant-numeric:tabular-nums; }
  .clx .alert { background:var(--urg-soft); color:var(--urg); border-radius:12px; text-align:center; padding:10px; font-size:14px; margin:16px 0; }
  .clx .chips { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-top:16px; }
  .clx .chip { font-size:12px; color:var(--subtle); border:1px solid var(--line); border-radius:999px; padding:6px 10px; }
  .clx section { padding:64px 0; }
  .clx .surf { background:var(--surf); border-block:1px solid var(--line); }
  .clx .navy { background:var(--navy); color:var(--inv); }
  .clx .navy h2 { color:var(--inv); }
  .clx .soft { background:var(--pri-soft); }
  .clx .h2 { text-align:center; font-size:clamp(26px,3.2vw,40px); margin-top:8px; }
  .clx .box { background:var(--bg); border:1px solid var(--line); border-radius:16px; padding:20px; display:flex; gap:12px; }
  .clx .x { width:32px; height:32px; border-radius:50%; background:var(--urg-soft); color:var(--urg); display:grid; place-items:center; flex-shrink:0; font-weight:700; }
  .clx .ok { width:20px; height:20px; color:var(--pri); flex-shrink:0; }
  .clx .feat { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .clx .feat article, .clx .steps article, .clx .quotes blockquote { background:var(--surf); border:1px solid var(--line); border-radius:16px; padding:24px; }
  .clx .steps { display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; text-align:center; }
  .clx .quotes { display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; }
  .clx .stats { display:flex; justify-content:center; gap:40px; text-align:center; margin-top:40px; }
  .clx .stats b { display:block; font-family:Fraunces,serif; font-size:32px; color:var(--pri); font-weight:500; }
  .clx .author { display:grid; grid-template-columns:200px 1fr; gap:32px; align-items:center; max-width:880px; margin:0 auto; }
  .clx .author img { border-radius:24px; width:100%; object-fit:cover; aspect-ratio:3/4; }
  .clx .bonus { display:flex; gap:16px; background:var(--surf); border:1px solid var(--line); border-radius:16px; padding:20px; margin:12px 0; }
  .clx .num { width:48px; height:48px; border-radius:8px; background:var(--warm); color:var(--pri); display:grid; place-items:center; font-family:Fraunces,serif; flex-shrink:0; }
  .clx .tag { font-size:12px; font-weight:600; color:var(--pri); background:var(--pri-soft); border-radius:999px; padding:4px 10px; }
  .clx .stack { max-width:520px; margin:32px auto 0; background:rgba(0,0,0,.25); border:1px solid rgba(255,255,255,.1); border-radius:24px; padding:24px; }
  .clx .row { display:flex; justify-content:space-between; padding:12px 0; border-bottom:1px solid rgba(255,255,255,.1); font-size:14px; }
  .clx .faq details { background:var(--bg); border:1px solid var(--line); border-radius:16px; padding:16px 20px; margin:8px 0; }
  .clx .faq summary { font-weight:600; cursor:pointer; list-style:none; display:flex; justify-content:space-between; gap:12px; }
  .clx .sticky { position:fixed; left:0; right:0; bottom:0; z-index:40; background:var(--navy); color:var(--inv); padding:12px 16px calc(12px + env(safe-area-inset-bottom)); }
  .clx .sticky-in { width:min(720px,100%); margin:0 auto; display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; }
  .clx .sticky .cta { width:auto; min-width:200px; }
  .clx .toast { position:fixed; top:64px; right:16px; z-index:30; background:var(--surf); border:1px solid var(--line); border-radius:16px; padding:12px 16px; font-size:14px; max-width:260px; display:none; box-shadow:0 12px 30px rgba(28,25,23,.12); }
  .clx .modal { position:fixed; inset:0; z-index:50; background:rgba(28,25,23,.5); display:none; place-items:center; padding:16px; }
  .clx .modal.open { display:grid; }
  .clx .modal-card { background:var(--surf); border-radius:24px; padding:32px 24px; max-width:420px; text-align:center; }
  .clx .ghost { background:none; border:0; color:var(--subtle); margin-top:12px; cursor:pointer; font:inherit; }
  body:has(.clx) .shopify-section-group-header-group,
  body:has(.clx) .shopify-section-group-footer-group,
  body:has(.clx) #shopify-section-header,
  body:has(.clx) #shopify-section-footer { display:none !important; }
  @media (max-width:800px) {
    .clx .grid2, .clx .feat, .clx .steps, .clx .quotes, .clx .author { grid-template-columns:1fr; }
    .clx .now { font-size:40px; }
    .clx .sticky .cta { width:100%; }
  }
</style>

