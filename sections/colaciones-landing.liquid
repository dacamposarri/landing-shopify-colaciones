<script>
(function () {
  var left = 15 * 60;
  function tick() {
    var m = String(Math.floor(left / 60)).padStart(2, "0");
    var s = String(left % 60).padStart(2, "0");
    document.querySelectorAll(".js-timer").forEach(function (el) { el.textContent = m + ":" + s; });
    if (left > 0) left--;
  }
  tick();
  setInterval(tick, 1000);

  var names = [
    "Francisca M. de Santiago compró la guía",
    "Camila R. de Viña del Mar descargó el pack",
    "Javiera P. de Concepción compró hace un momento",
    "Daniela S. de Temuco adquirió los bonos"
  ];
  var toast = document.getElementById("clx-toast");
  var i = 0;
  function showToast() {
    toast.textContent = names[i % names.length];
    toast.style.display = "block";
    i++;
    setTimeout(function () { toast.style.display = "none"; }, 4000);
  }
  setTimeout(showToast, 2500);
  setInterval(showToast, 14000);

  var armed = false;
  setTimeout(function () { armed = true; }, 12000);
  var modal = document.getElementById("clx-exit");
  document.addEventListener("mouseout", function (e) {
    if (!armed || e.clientY >= 12 || window.scrollY < 280) return;
    armed = false;
    modal.classList.add("open");
  });
  document.getElementById("clx-no").onclick = function () { modal.classList.remove("open"); };
  modal.addEventListener("click", function (e) { if (e.target === modal) modal.classList.remove("open"); });
})();
</script>

